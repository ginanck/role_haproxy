    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_routing_rules — ACL-based backend routing from a structured
   routing_rules list. Generates acl lines + use_backend or deny.

   Supported condition types:
     host        → hdr(host) -i <value>
     path_beg    → path_beg <value>
     path_end    → path_end <value>
     path_reg    → path_reg <value>
     method      → method <value>
     src_ip      → src <value>
     user_agent  → hdr(user-agent) -i <value>
     ssl_sni     → req_ssl_sni -i <value>
     header      → hdr(<header_name>) <value>  (requires hdr.header_name)

   operator: and (default) | or
   action: backend (default) | reject
----------------------------------------------------------------- #}
{%- macro add_routing_rules(item) %}
    {% if item.routing_rules is defined %}
        {% for rule in item.routing_rules %}
            {# Generate one ACL per condition #}
            {% for cond in rule.conditions %}
                {% set acl_name = rule.name ~ "_" ~ loop.index %}
                {% if cond.type == 'host' %}
    acl         {{ acl_name }} hdr(host) -i {{ cond.value }}
                {% elif cond.type == 'path_beg' %}
    acl         {{ acl_name }} path_beg {{ cond.value }}
                {% elif cond.type == 'path_end' %}
    acl         {{ acl_name }} path_end {{ cond.value }}
                {% elif cond.type == 'path_reg' %}
    acl         {{ acl_name }} path_reg {{ cond.value }}
                {% elif cond.type == 'method' %}
    acl         {{ acl_name }} method {{ cond.value }}
                {% elif cond.type == 'src_ip' %}
    acl         {{ acl_name }} src {{ cond.value }}
                {% elif cond.type == 'user_agent' %}
    acl         {{ acl_name }} hdr(user-agent) -i {{ cond.value }}
                {% elif cond.type == 'ssl_sni' %}
    acl         {{ acl_name }} req_ssl_sni -i {{ cond.value }}
                {% elif cond.type == 'header' %}
    acl         {{ acl_name }} hdr({{ cond.header_name }}) {{ cond.value }}
                {% endif %}
            {% endfor %}
            {# Build ACL combination expression #}
            {% set acl_refs = [] %}
            {% for cond in rule.conditions %}
                {% set _ = acl_refs.append(rule.name ~ "_" ~ loop.index) %}
            {% endfor %}
            {% if rule.operator | default('and') == 'or' %}
                {% set acl_expr = acl_refs | join(' or ') %}
            {% else %}
                {% set acl_expr = acl_refs | join(' ') %}
            {% endif %}
            {# Emit action #}
            {% if rule.action | default('backend') == 'reject' %}
    http-request deny if {{ acl_expr }}
            {% else %}
    use_backend {{ rule.backend }} if {{ acl_expr }}
            {% endif %}
        {% endfor %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_rate_limiting — inject stick table + tracking + deny rule
   for frontends referenced by haproxy_rate_limits.

   Called per-frontend with (frontend_item, rate_limits, stick_tables).
   Matches by apply_to == 'frontend' (all) or apply_to == frontend name.
----------------------------------------------------------------- #}
{%- macro add_rate_limiting(item, rate_limits, stick_tables) %}
    {% if rate_limits is defined and stick_tables is defined %}
        {% set _seen_tables = [] %}
        {% for limit in rate_limits %}
            {% if limit.apply_to == 'frontend' or limit.apply_to == item.name %}
                {% if limit.table not in _seen_tables %}
                    {% if _seen_tables.append(limit.table) %}{% endif %}
    tcp-request connection track-sc0 {{ limit.track | default('src') }} table {{ limit.table }}
                {% endif %}
                {% if limit.action | default('reject') == 'reject' %}
    tcp-request connection reject if {{ limit.condition }}
                {% elif limit.action == 'tarpit' %}
    tcp-request connection tarpit if {{ limit.condition }}
                {% elif limit.action == 'deny' %}
    http-request deny if {{ limit.condition }}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_rate_limit_tables — emit standalone backend sections for each
   stick-table used by rate limits. Called once at config level.
----------------------------------------------------------------- #}
{%- macro add_rate_limit_tables(stick_tables, rate_limits) %}
    {% if stick_tables is defined %}
        {% for table in stick_tables %}

backend {{ table.name }}
    stick-table type {{ table.type }} size {{ table.size }}{{ " expire " ~ table.expire if table.expire is defined else "" }}{% if table.store is defined %} store {{ table.store | join(",") }}{% endif %}

        {% endfor %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_security_rules — inject IP whitelist/blacklist rules into a
   frontend section based on haproxy_security configuration.
----------------------------------------------------------------- #}
{%- macro add_security_rules(item, security) %}
    {% if security is defined %}
        {# IP Blacklist #}
        {% if security.ip_blacklist.enabled | default(false) %}
            {% set _apply = security.ip_blacklist.apply_to | default([]) %}
            {% if _apply | length == 0 or item.name in _apply %}
                {% if security.ip_blacklist.ips | length > 0 %}
    acl         acl_ip_blacklist src {{ security.ip_blacklist.ips | join(' ') }}
    http-request deny if acl_ip_blacklist
                {% endif %}
            {% endif %}
        {% endif %}
        {# IP Whitelist #}
        {% if security.ip_whitelist.enabled | default(false) %}
            {% set _apply = security.ip_whitelist.apply_to | default([]) %}
            {% if _apply | length == 0 or item.name in _apply %}
                {% if security.ip_whitelist.ips | length > 0 %}
    acl         acl_ip_whitelist src {{ security.ip_whitelist.ips | join(' ') }}
    http-request deny if !acl_ip_whitelist
                {% endif %}
            {% endif %}
        {% endif %}
        {# Request body size limit (HTTP-only — skip for TCP frontends) #}
        {% if security.request_body_size_limit.enabled | default(false) and item.mode | default('http') == 'http' %}
    option      http-buffer-request
    http-request deny if { req.body_size gt {{ security.request_body_size_limit.max_bytes | default(10485760) }} }
        {% endif %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_maxconn — per-frontend or per-backend maxconn.
   Key: maxconn: N
   (Distinct from defaults maxconn; emits "maxconn N" in the section.)
----------------------------------------------------------------- #}
{%- macro add_maxconn(item) %}
    {% if item.maxconn is defined %}
    maxconn     {{ item.maxconn }}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_redispatch — backend redispatch option.
   Key: redispatch: true | false | interval (e.g. "1")
----------------------------------------------------------------- #}
{%- macro add_redispatch(item) %}
    {% if item.redispatch is defined and item.redispatch %}
        {% if item.redispatch is string %}
    option      redispatch {{ item.redispatch }}
        {% else %}
    option      redispatch
        {% endif %}
    {% endif %}
{%- endmacro %}
