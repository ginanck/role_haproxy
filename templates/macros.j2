{# -----------------------------------------------------------------
   add_binds — extended to support SSL termination, HTTP/2, mTLS.
   Backward-compatible: existing cert_path key still works.
   New keys per bind entry:
     ssl: true/false           — enable SSL termination
     cert: /path/to/pem        — PEM file (alias for cert_path)
     crt_list: /path/to/list   — multi-domain SNI cert list
     http2: true/false         — add alpn h2,http/1.1
     ciphers: "..."            — per-bind cipher override
     options: "no-sslv3 ..."   — per-bind SSL options
     verify: required          — mTLS client verification
     ca_file: /path/to/ca.pem  — mTLS CA bundle
----------------------------------------------------------------- #}
{%- macro add_binds(item) %}
    {% for socket in item.bind %}
        {% if socket.path is defined %}
    bind        {{ socket.path }}
        {% elif socket.address is defined and socket.port is defined %}
            {% set _ssl = socket.ssl | default(false) or socket.cert_path is defined or socket.cert is defined or socket.crt_list is defined %}
            {% if _ssl %}
                {% if socket.crt_list is defined %}
    bind        {{ socket.address }}:{{ socket.port }} ssl crt-list {{ socket.crt_list }}{{ " alpn h2,http/1.1" if socket.http2 | default(false) else "" }}{{ " ciphers " ~ socket.ciphers if socket.ciphers is defined and socket.ciphers != "" else "" }}{{ " " ~ socket.options if socket.options is defined and socket.options != "" else "" }}{{ " verify " ~ socket.verify if socket.verify is defined and socket.verify != "" else "" }}{{ " ca-file " ~ socket.ca_file if socket.ca_file is defined and socket.ca_file != "" else "" }}
                {% elif socket.cert is defined %}
    bind        {{ socket.address }}:{{ socket.port }} ssl crt {{ socket.cert }}{{ " alpn h2,http/1.1" if socket.http2 | default(false) else "" }}{{ " ciphers " ~ socket.ciphers if socket.ciphers is defined and socket.ciphers != "" else "" }}{{ " " ~ socket.options if socket.options is defined and socket.options != "" else "" }}{{ " verify " ~ socket.verify if socket.verify is defined and socket.verify != "" else "" }}{{ " ca-file " ~ socket.ca_file if socket.ca_file is defined and socket.ca_file != "" else "" }}
                {% elif socket.cert_path is defined %}
    bind        {{ socket.address }}:{{ socket.port }} ssl crt {{ socket.cert_path }}{{ " alpn h2,http/1.1" if socket.http2 | default(false) else "" }}{{ " ciphers " ~ socket.ciphers if socket.ciphers is defined and socket.ciphers != "" else "" }}{{ " " ~ socket.options if socket.options is defined and socket.options != "" else "" }}{{ " verify " ~ socket.verify if socket.verify is defined and socket.verify != "" else "" }}{{ " ca-file " ~ socket.ca_file if socket.ca_file is defined and socket.ca_file != "" else "" }}
                {% else %}
    bind        {{ socket.address }}:{{ socket.port }} ssl{{ " alpn h2,http/1.1" if socket.http2 | default(false) else "" }}{{ " ciphers " ~ socket.ciphers if socket.ciphers is defined and socket.ciphers != "" else "" }}{{ " " ~ socket.options if socket.options is defined and socket.options != "" else "" }}{{ " verify " ~ socket.verify if socket.verify is defined and socket.verify != "" else "" }}{{ " ca-file " ~ socket.ca_file if socket.ca_file is defined and socket.ca_file != "" else "" }}
                {% endif %}
            {% else %}
    bind        {{ socket.address }}:{{ socket.port }}
            {% endif %}
        {% endif %}
    {% endfor %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_servers — extended to support structured server params.
   Backward-compatible: existing 'params' string key still works and
   takes precedence when present.
   New keys per server entry:
     check: true/false         — enable health checks
     weight: N
     backup: true/false
     maxconn: N
     slowstart: "60s"
     send_proxy: v1/v2/none    — proxy protocol version to send
     inter: "5s"               — health check interval
     rise: N                   — health check rise threshold
     fall: N                   — health check fall threshold
----------------------------------------------------------------- #}
{%- macro add_servers(item) %}
    {% if item.server is defined %}
        {% for server in item.server %}
            {% if server.port is defined %}
                {% if server.params is defined %}
    server      {{ server.name }} {{ server.address }}:{{ server.port }} {{ server.params }}
                {% else %}
    server      {{ server.name }} {{ server.address }}:{{ server.port }}{{ " check" if server.check | default(false) else "" }}{{ " weight " ~ server.weight if server.weight is defined else "" }}{{ " backup" if server.backup | default(false) else "" }}{{ " maxconn " ~ server.maxconn if server.maxconn is defined else "" }}{{ " slowstart " ~ server.slowstart if server.slowstart is defined else "" }}{{ " inter " ~ server.inter if server.inter is defined else "" }}{{ " rise " ~ server.rise if server.rise is defined else "" }}{{ " fall " ~ server.fall if server.fall is defined else "" }}{{ " send-proxy-v2" if server.send_proxy is defined and server.send_proxy == 'v2' else "" }}{{ " send-proxy" if server.send_proxy is defined and server.send_proxy == 'v1' else "" }}
                {% endif %}
            {% else %}
    server      {{ server.name }} {{ server.address }} {{ server.params | default("") }}
            {% endif %}
        {% endfor %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_healthcheck — extended health check block.
   Generates option httpchk + http-check commands from a structured
   'healthcheck' key:
     type: http | tcp
     method: GET
     path: /health
     expect: "status 200"
     interval: 5s
     rise: 2
     fall: 3
----------------------------------------------------------------- #}
{%- macro add_healthcheck(item) %}
    {% if item.healthcheck is defined %}
        {% if item.healthcheck.type | default('tcp') == 'http' %}
    option      httpchk {{ item.healthcheck.method | default('GET') }} {{ item.healthcheck.path | default('/') }}
            {% if item.healthcheck.expect is defined %}
    http-check  expect {{ item.healthcheck.expect }}
            {% endif %}
        {% else %}
    option      tcp-check
        {% endif %}
        {% if item.healthcheck.interval is defined or item.healthcheck.rise is defined or item.healthcheck.fall is defined %}
    default-server{{ " inter " ~ item.healthcheck.interval if item.healthcheck.interval is defined else "" }}{{ " rise " ~ item.healthcheck.rise if item.healthcheck.rise is defined else "" }}{{ " fall " ~ item.healthcheck.fall if item.healthcheck.fall is defined else "" }}
        {% endif %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_source_ip — backend source IP binding for asymmetric routing.
   Priority: item.source_ip → haproxy_private_ip (global).
   Outputs: source <ip>
----------------------------------------------------------------- #}
{%- macro add_source_ip(item) %}
    {% set _src = item.source_ip | default(haproxy_private_ip | default('')) %}
    {% if _src != '' %}
    source      {{ _src }}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_forwardfor — forwardfor option + optional header stripping.
   Keys:
     forwardfor: true/false
     strip_forwarded_for: true/false   — delete client-supplied header first
----------------------------------------------------------------- #}
{%- macro add_forwardfor(item) %}
    {% if item.forwardfor | default(false) %}
        {% if item.strip_forwarded_for | default(false) %}
    http-request del-header X-Forwarded-For
        {% endif %}
    option      forwardfor
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_request_response_headers — structured header manipulation.
   Keys:
     request_headers:
       - action: set | add | del
         name: Header-Name
         value: "value"          (not required for action: del)
         condition: "acl_name"   (optional)
     response_headers: (same structure)
----------------------------------------------------------------- #}
{%- macro add_request_response_headers(item) %}
    {% if item.request_headers is defined %}
        {% for hdr in item.request_headers %}
            {% if hdr.action == 'del' %}
                {% if hdr.condition is defined %}
    http-request del-header {{ hdr.name }} if {{ hdr.condition }}
                {% else %}
    http-request del-header {{ hdr.name }}
                {% endif %}
            {% else %}
                {% if hdr.condition is defined %}
    http-request {{ hdr.action }}-header {{ hdr.name }} {{ hdr.value | default('') }} if {{ hdr.condition }}
                {% else %}
    http-request {{ hdr.action }}-header {{ hdr.name }} {{ hdr.value | default('') }}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if item.response_headers is defined %}
        {% for hdr in item.response_headers %}
            {% if hdr.action == 'del' %}
                {% if hdr.condition is defined %}
    http-response del-header {{ hdr.name }} if {{ hdr.condition }}
                {% else %}
    http-response del-header {{ hdr.name }}
                {% endif %}
            {% else %}
                {% if hdr.condition is defined %}
    http-response {{ hdr.action }}-header {{ hdr.name }} {{ hdr.value | default('') }} if {{ hdr.condition }}
                {% else %}
    http-response {{ hdr.action }}-header {{ hdr.name }} {{ hdr.value | default('') }}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_path_rewrite — request path/URI rewriting.
   Keys:
     path_rewrite:
       type: replace-path | replace-uri | set-path
       pattern: "^/old(.*)"
       replacement: "/new\\1"
       condition: "acl_name"  (optional)
----------------------------------------------------------------- #}
{%- macro add_path_rewrite(item) %}
    {% if item.path_rewrite is defined %}
        {% if item.path_rewrite.type == 'set-path' %}
            {% if item.path_rewrite.condition is defined %}
    http-request set-path {{ item.path_rewrite.replacement }} if {{ item.path_rewrite.condition }}
            {% else %}
    http-request set-path {{ item.path_rewrite.replacement }}
            {% endif %}
        {% else %}
            {% if item.path_rewrite.condition is defined %}
    http-request {{ item.path_rewrite.type }} {{ item.path_rewrite.pattern }} {{ item.path_rewrite.replacement }} if {{ item.path_rewrite.condition }}
            {% else %}
    http-request {{ item.path_rewrite.type }} {{ item.path_rewrite.pattern }} {{ item.path_rewrite.replacement }}
            {% endif %}
        {% endif %}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_session_persistence — cookie-based session persistence.
   Keys:
     session_persistence:
       enabled: true
       cookie_name: SERVERID
       mode: insert | rewrite | prefix
       options: "nocache"   (extra cookie options string)
----------------------------------------------------------------- #}
{%- macro add_session_persistence(item) %}
    {% if item.session_persistence is defined and item.session_persistence.enabled | default(false) %}
    cookie      {{ item.session_persistence.cookie_name | default('SERVERID') }} {{ item.session_persistence.mode | default('insert') }}{{ " " ~ item.session_persistence.options if item.session_persistence.options is defined and item.session_persistence.options != "" else "" }}
    {% endif %}
{%- endmacro %}

{# -----------------------------------------------------------------
   add_proxy_protocol — backend-level proxy protocol for all servers.
   Overridden per-server via server.send_proxy key.
   Key: proxy_protocol: none | v1 | v2
----------------------------------------------------------------- #}
{%- macro add_proxy_protocol(item) %}
    {% if item.proxy_protocol is defined and item.proxy_protocol != 'none' and item.proxy_protocol != '' %}
        {% if item.proxy_protocol == 'v2' %}
    default-server send-proxy-v2
        {% elif item.proxy_protocol == 'v1' %}
    default-server send-proxy
        {% endif %}
    {% endif %}
{%- endmacro %}

