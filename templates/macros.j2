{# -----------------------------------------------------------------
   add_tcp_inspect_delay — TCP inspect delay for a frontend.
   Key: tcp_inspect_delay: "5s"
----------------------------------------------------------------- #}
{%- macro add_tcp_inspect_delay(item) %}
